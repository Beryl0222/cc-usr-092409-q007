{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "银龄多形态课程接续领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "COURSE_PUBLISHED",
        "COURSE_VERSIONED",
        "LEARNER_REGISTERED",
        "SUPPORT_UPDATED",
        "SAFETY_RESTRICTION_APPLIED",
        "SAFETY_RESTRICTION_LIFTED",
        "ENROLLMENT_PLACED",
        "ELIGIBILITY_CHANGED",
        "TRANSFER_PROPOSED",
        "TRANSFER_CONFIRMED",
        "TRANSFER_DECLINED",
        "TRANSFER_EXPIRED",
        "GOAL_SET",
        "GOAL_CONTINUED",
        "SESSION_RECORDED",
        "CHECKIN_UPLOADED",
        "CHECKIN_CONFLICT_RAISED",
        "CHECKIN_CONFLICT_RESOLVED",
        "ABSENCE_ATTRIBUTED",
        "OUTCOME_REVIEWED",
        "WAITLIST_JOINED",
        "WAITLIST_OFFERED",
        "WAITLIST_PROMOTED",
        "WAITLIST_OFFER_EXPIRED",
        "STAGE_REVIEW_RECORDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "learner_profile",
        "course_offering",
        "enrollment",
        "learning_record",
        "course_session",
        "transfer_proposal",
        "waitlist_entry"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
