{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "银龄多形态课程接续领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "COURSE_PUBLISHED",
        "ENROLLMENT_PLACED",
        "SUPPORT_UPDATED",
        "SESSION_RECORDED",
        "OUTCOME_REVIEWED",
        "LEARNER_REGISTERED",
        "COURSE_VERSION_PUBLISHED",
        "ELIGIBILITY_UPDATED",
        "SAFETY_RESTRICTION_SET",
        "TRANSFER_PROPOSED",
        "TRANSFER_CONFIRMED",
        "TRANSFER_REJECTED",
        "TRANSFER_EXPIRED",
        "TRANSFER_CANCELLED",
        "RECORD_CORRECTED",
        "GOAL_CARRIED",
        "CHECKIN_RECORDED",
        "CHECKIN_CONFLICT_RAISED",
        "CHECKIN_CONFLICT_RESOLVED",
        "WAITLIST_APPLIED",
        "WAITLIST_OFFERED",
        "WAITLIST_ENROLLED",
        "WAITLIST_EXPIRED",
        "WAITLIST_CANCELLED",
        "REMINDER_SENT"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "learner_profile",
        "course_offering",
        "enrollment",
        "learning_record",
        "transfer_proposal",
        "waitlist_entry",
        "checkin"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
